# ==============================================================================
# AI Study Companion - Environment Configuration
# ==============================================================================

# Application Port (default: 5000)
PORT=5000

# JSON Web Token Secret (replace with a cryptographically strong secret for production)
JWT_SECRET=ai-study-companion-secure-jwt-secret-key-university-2026

# Google Gemini API Key (recommended primary AI engine)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional: OpenAI API Key (used as fallback or alternative LLM)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: Custom SQLite database path override
# DATABASE_PATH=/path/to/study_companion.db
